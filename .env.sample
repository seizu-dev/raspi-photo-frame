# 写真取得元。immich（既定）/ gdrive / local / s3。未設定・空文字は immich として扱われる。
# PF_PHOTO_PROVIDER=immich

# Immich API の資格情報。.env としてコピーしてから値を入れる。
IMMICH_BASE_URL=http://immich.example.local:2283
IMMICH_API_KEY=change-me

# --- PF_PHOTO_PROVIDER=gdrive を使う場合のみ ---
# サービスアカウントの JSON 鍵ファイルのパス（README の「番外: Google Drive を写真の
# 取得元にする」参照）。未設定なら config ディレクトリ直下の gdrive-service-account.json を探す
# （PF_CONFIG_DIR 未設定時は ./config/gdrive-service-account.json）。
# GDRIVE_SA_KEY_FILE=/config/gdrive-service-account.json
# 写真を置くルートフォルダの ID。必須。フォルダを開いたときの URL の `/folders/` より
# 後ろの部分（`?usp=sharing` などは含めない）。
#   https://drive.google.com/drive/folders/<ここがフォルダ ID>?usp=sharing
# GDRIVE_ROOT_FOLDER_ID=

# --- PF_PHOTO_PROVIDER=local を使う場合のみ ---
# ホスト側の写真フォルダ。docker-compose.yml がコンテナの /photos へ読み取り専用で
# マウントする。未設定なら ./photos。存在しないパスは Docker が root 所有で作るため、
# 先に自分の権限で作っておくこと（README の「番外: ローカルフォルダ」参照）。
# PF_LOCAL_PHOTO_DIR=./photos
# コンテナ内から見た写真ルート。未設定なら /photos（無ければ ./photos）。
# compose の /photos へマウントする通常構成では変更不要。
# LOCAL_PHOTO_ROOT=/photos

# --- PF_PHOTO_PROVIDER=s3 を使う場合のみ ---
# S3 互換ストレージ（Google Cloud Storage の XML API・MinIO・R2 など）。README の
# 「番外: S3 互換ストレージ」参照。path-style（<endpoint>/<bucket>/<key>）のみ対応。
# エンドポイント URL。必須。GCS なら https://storage.googleapis.com
# S3_ENDPOINT_URL=https://storage.googleapis.com
# バケット名。必須。
# S3_BUCKET=your-bucket-name
# 写真のルートにするプレフィックス（任意）。末尾は / にする。未設定ならバケット直下。
# S3_PREFIX=photos/
# アクセスキー ID とシークレット。必須。GCS では HMAC キー（サービスアカウントに紐づけて作る）。
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# 署名に使うリージョン名。未設定なら auto（GCS はこの値で通る）。
# S3_REGION=auto

# デバイスの GID（ホスト固有の実測値）。docker-compose.yml の group_add で使う。
# 実機での確認コマンド: getent group video render input gpio
# 以下は開発に使った実機での実測値（SPECIFICATION.md 9-8）をデフォルトとしてコメントで示す。
# 別の実機では値が異なりうるため、必ず実機で確認してから上書きすること。
# GID_VIDEO=44
# GID_RENDER=992
# GID_INPUT=996
# GID_GPIO=986

# docker-compose.yml の image: が参照するタグ。未設定なら latest（GHCR の最新版）を使う。
# バージョンを固定したいときは Release のタグ名（先頭の v を除いた形）を入れる。
#   PF_IMAGE_TAG=1.0.0
# PF_IMAGE_TAG=

# --- Dev Container（階層1）: ホストの Claude Code 設定を共有する（任意） ---
# 未設定なら隔離された名前付きボリューム（claude-config）を使う。ホストのファイルには
# 一切触れない。ホストの ~/.claude（ログイン・settings・agents・commands・skills・MCP認証）
# を共有したい場合のみ、絶対パスを設定してから「Dev Containers: Rebuild Container」する。
#   Windows (Docker Desktop): HOST_CLAUDE_DIR=C:\Users\you\.claude
#   Linux/macOS/WSL:          HOST_CLAUDE_DIR=/home/you/.claude
# HOST_CLAUDE_DIR=
