# Claude Code
.claude/plans/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 秘匿情報
/config.py
/settings.json
/.env
/config/settings.json
# Google Drive のサービスアカウント鍵（gdrive-service-account.json 等）。
# config/ 配下の JSON はサンプルを除きすべて秘匿情報として扱う。
/config/*.json
!/config/settings.sample.json

# キャッシュ
cache/

# ローカルフォルダ取得元の写真置き場（PF_LOCAL_PHOTO_DIR の既定）
/photos/

# 先行プロジェクト photo-frame の参照用 clone（移植元。追跡しない）
/.reference/

# 非公開オーバーレイ（開発記録・実機の接続情報・秘匿検査の hook）。
# 別リポジトリを .claude/context/ へ clone して重ねる。
# セットアップ手順は .claude/workflows.md の「非公開オーバーレイの運用」を参照。
# この2行が無いと非公開情報がそのまま公開リポジトリへコミットされる。
/.claude/context/
/CLAUDE.local.md
